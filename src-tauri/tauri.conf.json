{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Desk",
  "version": "0.2.1",
  "identifier": "com.rajvee.voicedesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Desk",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": false,
        "center": true,
        "create": false
      },
      {
        "label": "overlay",
        "title": "",
        "url": "index.html#overlay",
        "width": 214,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local voice dictation and meeting task extraction",
    "macOS": {
      "minimumSystemVersion": "14.2"
    },
    "linux": {
      "deb": {
        "depends": [
          "libpipewire-0.3-0",
          "libasound2"
        ]
      }
    },
    "resources": {
      "../engine/commands.py": "engine/commands.py",
      "../engine/engine.py": "engine/engine.py",
      "../engine/indic.py": "engine/indic.py",
      "../engine/meeting.py": "engine/meeting.py",
      "../engine/mixed.py": "engine/mixed.py",
      "../engine/recordings.py": "engine/recordings.py",
      "../engine/runtime.py": "engine/runtime.py",
      "../engine/speakers.py": "engine/speakers.py",
      "../engine/speech.py": "engine/speech.py",
      "../engine/stream.py": "engine/stream.py",
      "../engine/transcriber.py": "engine/transcriber.py",
      "../engine/voice.py": "engine/voice.py",
      "../engine/voiceprint.py": "engine/voiceprint.py",
      "../engine/requirements*.txt": "engine/",
      "../engine/constraints.txt": "engine/constraints.txt",
      "../engine/english-words.txt": "engine/english-words.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRjg4MTk5NzUzQ0U1QkUKUldTKzVUeDFtWUg0RTJmTDBjWm9ZaDNjOXVLNHFMeDRlZ0srNGMzbEdmS1FkNjZXdW5wVU92Y1cK",
      "endpoints": [
        "https://github.com/Nishchay-Mashruwala/Voice-Desk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}